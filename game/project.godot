; Engine configuration file.
; 阿柴快送 · Shiba Delivery — Godot 4.7 Desktop (Steam-First · Forward+)

config_version=5

[application]

config/name="阿柴快送 · Shiba Delivery"
config/description="一款偏严肃、带黑色幽默的第三人称 3D 骑行送单独立游戏（Godot 4.7 Forward+ · Steam 优先）"
run/main_scene="res://scenes/RongwanCorner.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=true

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
global_illumination/voxel_gi/quality=1
global_illumination/gi/use_half_resolution=true
environment/ssao/quality=2
environment/ssao/half_size=false
textures/default_filters/anisotropic_filtering_level=4
